{
  "name": "file-vault",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "github:env": "tsx scripts/github-env.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate --config packages/shared/drizzle.config.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "cloudflare:prepare": "tsx scripts/prepare-cloudflare.ts",
    "verify:r2": "tsx scripts/verify-r2.ts",
    "verify:large-copy": "tsx scripts/verify-large-copy.ts",
    "verify:live": "tsx scripts/verify-live.ts",
    "deploy": "tsx scripts/deploy.ts",
    "cf": "cf",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1162.0",
    "@aws-sdk/s3-request-presigner": "3.1162.0",
    "@noble/hashes": "2.4.0",
    "@xmldom/xmldom": "0.9.12",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "jose": "6.2.15",
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.5",
    "remark-gfm": "4.0.1",
    "unicode-case-folding": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.11",
    "@cloudflare/workers-types": "5.20261104.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "cf": "1.0.0-beta.27",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
